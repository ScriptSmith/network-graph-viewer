{
  "name": "network-graph-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:widget": "tsc -b && pnpm widget",
    "lint": "oxlint --ignore-pattern 'python/**'",
    "test": "pnpm widget && vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "widget": "vite build --config vite.embed.config.ts"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "hyparquet": "^1.26.2",
    "hyparquet-compressors": "^1.1.1",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "hyparquet-writer": "^0.16.1",
    "jsdom": "^30.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.3.0"
}
